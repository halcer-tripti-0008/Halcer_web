# Runtime environment: development | production | test
NODE_ENV=development

# HTTP port the API listens on
PORT=5000

# MongoDB connection string (use a dedicated user with least privileges in production)
MONGODB_URI=mongodb://127.0.0.1:27017/halcer

# Comma-separated list of allowed browser origins (no trailing slashes)
CORS_ORIGINS=http://localhost:5173

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Number of reverse-proxy hops to trust for client IPs (0 = none; 1 behind a single LB/CDN)
TRUST_PROXY=0

# Global API rate limit: max requests per window per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
