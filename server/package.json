{
  "name": "@halcer/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
