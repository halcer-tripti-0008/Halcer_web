# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put secrets here — everything below ships to every visitor.

# Base URL of the API. Use a relative path in dev (proxied by Vite) or an absolute URL in production.
VITE_API_BASE_URL=/api/v1

# Canonical public origin of the site (no trailing slash). Used for canonical URLs, Open Graph and sitemap.xml.
VITE_SITE_URL=http://localhost:5173

# Site name used in <title> templates and Open Graph metadata.
VITE_SITE_NAME=Halcer

# Dev-only: where the Vite dev server proxies /api requests.
API_PROXY_TARGET=http://localhost:5000

# Build-only: set to "true" ONLY for the production deployment. Anything else emits a robots.txt that blocks crawlers.
SEO_ALLOW_INDEXING=false
